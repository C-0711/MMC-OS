# MMC-OS — Umgebungs-Vorlage
#
# Review-Gate: echte URLs und Credentials kommen NIEMALS ins Repo.
# Kopieren und ausfüllen:   cp .env.example .env   (.env ist gitignored)
# Die App liest process.env — beim Start aus der Shell z. B.:
#   set -a; source .env; set +a; npm start

# OCR-Belegserver (lokal)
BELEGSRV_URL=http://127.0.0.1:8787

# vLLM (Gemma) — Adresse im eigenen Netz eintragen; Platzhalter = localhost-Mock
VLLM_URL=http://127.0.0.1:11435
VLLM_MODEL=gemma4-mm

# 0711-GitChain-Backend — ohne Werte bleibt die App fail-closed offline
GITCHAIN_API_URL=
GITCHAIN_AUTH_URL=
GITCHAIN_TYP=fall
GITCHAIN_NS=mmc

# Vault-Wurzel (Default: ~/MMC-Vault)
#MMC_VAULT=
