# MMC-OS — Beispiel-Env (NIEMALS echte Werte committen!)

# Vault-Wurzel (Standard: ~/MMC-Vault)
#MMC_VAULT=/Users/du/MMC-Vault

# vLLM (Lokales Netz; ohne VPN fällt die App auf Gemma Edge zurück)
#VLLM_URL=http://192.168.145.10:11435
#VLLM_MODEL=gemma4-mm

# gitchain-Backend (0711)
#GITCHAIN_API_URL=https://api.gl.0711.io

# Echte Werte gehören in secrets.env (chmod 600, NICHT committen)
# oder in die Keychain (PAT läuft über safeStorage, nie in Dateien).
