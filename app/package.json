{
  "name": "mmc-os",
  "version": "0.1.0",
  "description": "Der ruhige Raum — gitchain OS Desktop-App",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "build": "tsc && tsc -p tsconfig.renderer.json && cp src/renderer/index.html dist/renderer/ && cp src/renderer/tokens.css dist/renderer/",
    "start": "npm run build && electron .",
    "test": "rm -rf dist/test && tsc -p test/tsconfig.json && node --test 'dist/test/test/*.test.js'",
    "dist": "npm run build && electron-packager . MMC-OS --platform=darwin --arch=arm64 --out=release --overwrite --ignore='^/src' --ignore='^/test' --ignore='^/release' --ignore='^/tsconfig' --ignore='^/dist/test'"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.0.0",
    "electron": "^32.0.0",
    "typescript": "^5.5.0"
  }
}
