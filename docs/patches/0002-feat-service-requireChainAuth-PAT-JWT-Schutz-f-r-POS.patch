+/**
+ * Auth-Wächter für Verankerungs-Schreibrouten (OPS-SCHARFSCHALTUNG.md P1).
+ *
+ * Erlaubt:
+ *  (a) den pod-lokalen Anchor-Scheduler: Loopback-Quelle + Kennung
+ *      `x-scheduler: 1`. Er ruft POST /api/chain/submit über 127.0.0.1 im
+ *      selben Pod auf — derselbe Code-Pfad wie der Hand-Submit
+ *      (AUFTRAG-anchor-scheduler.md S.1). Sicher, weil simple-index.ts
+ *      KEIN `trust proxy` setzt: req.ip ist die rohe Socket-Adresse und
+ *      von außen (über Ingress) nicht auf 127.0.0.1 zu fälschen.
+ *  (b) authentifizierte Principals über die bestehende Infrastruktur in
+ *      middleware/auth.ts (X-API-Key gegen api_keys-Tabelle, Bearer =
+ *      0711-I-JWT oder Legacy-Session) — dieselbe Verifikation wie die
+ *      /v1/*-Flächen, kein neuer Auth-Pfad. API-Key-Principals brauchen
+ *      zusätzlich den Scope `chain:submit` (oder `admin`) — Konvention
+ *      wie requireScope() in middleware/auth.ts.
+ *
+ * Fehlerformat wie die Live-Registry: {"error": "…"} (401) bzw.
+ * {"error", "required", "granted"} (403, wie requireScope).
+ */
+
+import { Request, Response, NextFunction } from "express";
+
+import { authenticate, AuthenticatedRequest } from "./auth";
+
+export const CHAIN_SUBMIT_SCOPE = "chain:submit";
+
+export function requireChainAuth(req: Request, res: Response, next: NextFunction): void {
+  // (a) Scheduler-Loopback zulassen — sonst sperrt die Middleware den
+  // Scheduler selbst aus (genau der "zweiter Codepfad"-Fehler, den S.1 verbot).
+  const isLoopback =
+    req.ip === "127.0.0.1" || req.ip === "::1" || req.ip === "::ffff:127.0.0.1";
+  if (isLoopback && req.get("x-scheduler") === "1") {
+    next();
+    return;
+  }
+
+  // (b) Bestehende PAT-/JWT-Verifikation durchlaufen lassen; authenticate()
+  // ist permissiv (setzt req.user nur bei gültigem Credential), die harte
+  // Kante ziehen wir hier.
+  const areq = req as AuthenticatedRequest;
+  void authenticate(areq, res, () => {
+    if (!areq.user) {
+      res.status(401).json({ error: "Anmeldung erforderlich — chain/submit ist geschützt" });
+      return;
+    }
+    // Scope nur für API-Key-Principals erzwingen (requireScope-Konvention):
+    // JWT-/Session-User sind vollwertige Principals ohne Scope-Liste.
+    if (areq.user.apiKeyId) {
+      const scopes = areq.user.apiKeyScopes || [];
+      if (!scopes.includes(CHAIN_SUBMIT_SCOPE) && !scopes.includes("admin")) {
+        res.status(403).json({
+          error: "Insufficient scope",
+          required: CHAIN_SUBMIT_SCOPE,
+          granted: scopes,
+        });
+        return;
+      }
+    }
+    next();
+  });
+}
