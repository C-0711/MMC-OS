+/**
+ * Anchor-Scheduler support (AUFTRAG-anchor-scheduler.md): list pending batch
+ * IDs oldest-first so the scheduler can drain them one per tick.
+ */
+export async function getPendingBatchIds(): Promise<number[]> {
+  const rows = await chainQuery<{ batch_id: number }>(
+    "SELECT batch_id FROM certification_batches WHERE status = 'pending' ORDER BY batch_id ASC"
+  );
+  return rows.map((r) => Number(r.batch_id));
+}
+
+/**
+ * Anchor-Scheduler support: mark a batch as failed after the retry budget is
+ * exhausted (never downgrades a confirmed batch).
+ */
+export async function markBatchFailed(batchId: number): Promise<void> {
+  await chainQuery(
+    "UPDATE certification_batches SET status = 'failed' WHERE batch_id = $1 AND status <> 'confirmed'",
+    [batchId]
+  );
+}
