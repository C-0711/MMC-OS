+/**
+ * Anchor-Scheduler — automatic confirmation of pending certification batches.
+ *
+ * Built per AUFTRAG-anchor-scheduler.md (MMC-OS docs), based on the findings in
+ * DIAGNOSE-turbo-anchor.md: there was NO batcher/cron/timer — pending batches
+ * were only ever confirmed via manual `POST /api/chain/submit`
+ * (chain-routes.ts:131–174). This module adds the missing timer.
+ *
+ * Ground rules (from the Auftrag):
+ *  - NO second submit code path: every batch goes through the EXISTING HTTP
+ *    route `POST /api/chain/submit` on this very process (loopback self-call).
+ *    One source of truth for signing/wallet handling.
+ *  - Read-only (no wallet key -> walletAddress "read-only") is a deliberate
+ *    state, not an error: the tick logs one line and does nothing.
+ *  - Max 1 batch per tick (gas conservation; validate on testnet first).
+ *  - Backoff: max 3 failed attempts per batch, then the batch is marked
+ *    "failed" in the DB and a MANUELLE_KARTE log line is emitted. No silent
+ *    endless retry loop.
+ *  - Graceful shutdown: an in-flight tick (i.e. a running tx) finishes before
+ *    stop resolves (K8s rollout safe).
+ *
+ * Env:
+ *  - ANCHOR_SCHEDULER_INTERVAL_MS  tick interval, default 900000 (15 min),
+ *                                  0 = scheduler disabled.
+ */
+
+import { getBlockchainService } from "../chain-engine";
+import { getPendingBatchIds, markBatchFailed, logAudit } from "../chain-db";
+
+// ============================================
+// CONFIG
+// ============================================
+
+const DEFAULT_INTERVAL_MS = 15 * 60 * 1000; // 15 minutes
+const MAX_ATTEMPTS_PER_BATCH = 3;
+
+function configuredIntervalMs(): number {
+  const raw = process.env.ANCHOR_SCHEDULER_INTERVAL_MS;
+  if (raw === undefined || raw === "") return DEFAULT_INTERVAL_MS;
+  const n = Number(raw);
+  if (!Number.isFinite(n) || n < 0) return DEFAULT_INTERVAL_MS;
+  return Math.floor(n);
+}
+
+// ============================================
+// STATE / METRICS
+// ============================================
+
+export interface SchedulerMetrics {
+  /** true while the interval timer is armed */
+  laeuft: boolean;
+  /** configured tick interval in ms (0 = disabled) */
+  intervalMs: number;
+  /** ISO timestamp of the last completed tick, null before the first */
+  letzterTick: string | null;
+  /** batches successfully submitted (confirmed) by the scheduler */
+  verarbeiteteBatches: number;
+  /** total failed submit attempts (across all batches) */
+  fehlversuche: number;
+  /** batch IDs given up on after MAX_ATTEMPTS (need a manual look) */
+  fehlerhafteBatches: number[];
+}
+
+interface SchedulerState {
+  timer: NodeJS.Timeout | null;
+  intervalMs: number;
+  baseUrl: string;
+  tickInFlight: Promise<void> | null;
+  stopping: boolean;
+  letzterTick: string | null;
+  verarbeiteteBatches: number;
+  fehlversuche: number;
+  /** batchId -> failed attempt count (in-memory backoff budget) */
+  versuche: Map<number, number>;
+  /** batches marked failed after exhausting the budget */
+  fehlerhafteBatches: Set<number>;
+}
+
+const state: SchedulerState = {
+  timer: null,
+  intervalMs: 0,
+  baseUrl: "",
+  tickInFlight: null,
+  stopping: false,
+  letzterTick: null,
+  verarbeiteteBatches: 0,
+  fehlversuche: 0,
+  versuche: new Map(),
+  fehlerhafteBatches: new Set(),
+};
+
+export function getSchedulerMetrics(): SchedulerMetrics {
+  return {
+    laeuft: state.timer !== null,
+    intervalMs: state.intervalMs,
+    letzterTick: state.letzterTick,
+    verarbeiteteBatches: state.verarbeiteteBatches,
+    fehlversuche: state.fehlversuche,
+    fehlerhafteBatches: Array.from(state.fehlerhafteBatches).sort((a, b) => a - b),
+  };
+}
+
+// ============================================
+// S.3 — NETWORK CONSISTENCY GUARD
+// ============================================
+// Checks whether the wallet actually holds funds on the network the service is
+// configured for. The Sepolia-config / Mainnet-wallet conflict from
+// DIAGNOSE-turbo-anchor.md ("ZWEITES UPDATE") would have been visible in
+// seconds with this guard; now it is.
+
+const NETWORK_RPCS: Record<string, string> = {
+  "base-mainnet": process.env.ANCHOR_RPC_URL_MAINNET || "https://mainnet.base.org",
+  "base-sepolia": process.env.ANCHOR_RPC_URL_SEPOLIA || "https://sepolia.base.org",
+};
+
+let netzwerkHinweis: string | null = null;
+
+/** Current cross-chain mismatch hint for /api/chain/status (null = consistent). */
+export function getNetzwerkHinweis(): string | null {
+  return netzwerkHinweis;
+}
+
+async function ethGetBalance(rpcUrl: string, address: string): Promise<bigint | null> {
+  try {
+    const res = await fetch(rpcUrl, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        jsonrpc: "2.0",
+        id: 1,
+        method: "eth_getBalance",
+        params: [address, "latest"],
+      }),
+    });
+    if (!res.ok) return null;
+    const json: any = await res.json();
+    if (typeof json?.result !== "string") return null;
+    return BigInt(json.result);
+  } catch {
+    return null; // network guard must never crash the service
+  }
+}
+
+/**
+ * Compare configured network vs. where the wallet actually holds funds.
+ * Runs at startup and on every tick; failure-tolerant (RPC errors => no hint).
+ */
+export async function pruefeNetzwerkKonsistenz(): Promise<void> {
+  try {
+    const status = await getBlockchainService().getStatus();
+    if (!status.walletAddress || status.walletAddress === "read-only") {
+      // No wallet configured — nothing to compare yet.
+      netzwerkHinweis = null;
+      return;
+    }
+    const konfiguriert = status.network;
+    const gegenNetz = konfiguriert === "base-sepolia" ? "base-mainnet" : "base-sepolia";
+    const rpcKonfiguriert = NETWORK_RPCS[konfiguriert];
+    const rpcGegen = NETWORK_RPCS[gegenNetz];
+    if (!rpcKonfiguriert || !rpcGegen) return; // unknown network — no verdict
+
+    const [hier, dort] = await Promise.all([
+      ethGetBalance(rpcKonfiguriert, status.walletAddress),
+      ethGetBalance(rpcGegen, status.walletAddress),
+    ]);
+    if (hier === null || dort === null) return; // inconclusive — keep last verdict
+
+    if (hier === 0n && dort > 0n) {
+      netzwerkHinweis =
+        `Wallet ${status.walletAddress} hat Guthaben auf ${gegenNetz}, ` +
+        `Service läuft auf ${konfiguriert} — Cross-Chain-Mismatch ` +
+        `(siehe DIAGNOSE-turbo-anchor.md)`;
+      console.warn(`[anchor-scheduler] ${netzwerkHinweis}`);
+    } else {
+      netzwerkHinweis = null;
+    }
+  } catch {
+    // never let the guard take the service down
+  }
+}
+
+// ============================================
+// S.1 — TICK
+// ============================================
+
+async function submitViaRoute(batchId: number): Promise<{ ok: boolean; body: any; status: number }> {
+  // THE existing submit route — same code path as a manual submit.
+  const res = await fetch(`${state.baseUrl}/api/chain/submit`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ batchId }),
+  });
+  const body: any = await res.json().catch(() => null);
+  return { ok: res.ok && body?.success === true, body, status: res.status };
+}
+
+async function tick(): Promise<void> {
+  // 1. Network guard (cheap, failure-tolerant) — startup + every tick.
+  await pruefeNetzwerkKonsistenz();
+
+  // 2. Wallet check: read-only is a deliberate state — log only, no error.
+  const status = await getBlockchainService().getStatus();
+  if (status.walletAddress === "read-only") {
+    console.log(
+      "[anchor-scheduler] read-only (kein Wallet-Key konfiguriert) — nichts zu tun, " +
+        "pending Batches bleiben liegen bis der Key gesetzt ist"
+    );
+    return;
+  }
+  if (!status.connected) {
+    console.log("[anchor-scheduler] Blockchain nicht erreichbar — Tick übersprungen");
+    return;
+  }
+
+  // 3. Pending batches (oldest first), minus the ones we gave up on.
+  let pending: number[] = [];
+  try {
+    pending = await getPendingBatchIds();
+  } catch (e: any) {
+    console.error(`[anchor-scheduler] pending-Abfrage fehlgeschlagen: ${e?.message || e}`);
+    return;
+  }
+  const kandidaten = pending.filter((id) => !state.fehlerhafteBatches.has(id));
+  if (kandidaten.length === 0) return;
+
+  // 4. Max ONE batch per tick (gas conservation).
+  const batchId = kandidaten[0];
+  try {
+    const result = await submitViaRoute(batchId);
+    if (result.ok) {
+      state.verarbeiteteBatches++;
+      state.versuche.delete(batchId);
+      console.log(
+        `[anchor-scheduler] Batch #${batchId} bestätigt — tx=${result.body?.txHash} ` +
+          `block=${result.body?.blockNumber} network=${result.body?.network} ` +
+          `(${kandidaten.length - 1} weitere pending)`
+      );
+      return;
+    }
+    // "Already confirmed" means someone beat us to it — not a failure.
+    if (result.status === 400 && /already confirmed/i.test(String(result.body?.error || ""))) {
+      state.versuche.delete(batchId);
+      console.log(`[anchor-scheduler] Batch #${batchId} war bereits bestätigt — übersprungen`);
+      return;
+    }
+    throw new Error(`submit HTTP ${result.status}: ${result.body?.error || "unbekannter Fehler"}`);
+  } catch (e: any) {
+    // 5. Backoff: count the attempt; after MAX_ATTEMPTS mark failed + MANUELLE_KARTE.
+    state.fehlversuche++;
+    const n = (state.versuche.get(batchId) || 0) + 1;
+    state.versuche.set(batchId, n);
+    console.error(
+      `[anchor-scheduler] Batch #${batchId} Fehlversuch ${n}/${MAX_ATTEMPTS_PER_BATCH}: ${e?.message || e}`
+    );
+    if (n >= MAX_ATTEMPTS_PER_BATCH) {
+      state.fehlerhafteBatches.add(batchId);
+      state.versuche.delete(batchId);
+      try {
+        await markBatchFailed(batchId);
+      } catch (dbErr: any) {
+        console.error(
+          `[anchor-scheduler] Batch #${batchId} konnte nicht als failed markiert werden: ${dbErr?.message || dbErr}`
+        );
+      }
+      try {
+        await logAudit({
+          action: "batch_anchor_failed",
+          entityType: "batch",
+          entityId: String(batchId),
+          details: { fehlversuche: n, letzterFehler: String(e?.message || e) },
+        });
+      } catch {
+        /* audit best effort */
+      }
+      console.error(
+        `[anchor-scheduler] MANUELLE_KARTE: Batch #${batchId} nach ${n} Fehlversuchen auf ` +
+          `"failed" gesetzt — manueller POST /api/chain/submit nötig, sobald die Ursache behoben ist`
+      );
+    }
+  }
+}
+
+// ============================================
+// LIFECYCLE
+// ============================================
+
+/**
+ * Start the scheduler. Returns true if the timer was armed, false if disabled
+ * (interval 0). `port` is this service's own listen port for the loopback
+ * self-call to POST /api/chain/submit.
+ */
+export function startAnchorScheduler(opts: { port: number }): boolean {
+  state.intervalMs = configuredIntervalMs();
+  state.baseUrl = `http://127.0.0.1:${opts.port}`;
+  state.stopping = false;
+
+  if (state.intervalMs === 0) {
+    console.log("[anchor-scheduler] deaktiviert (ANCHOR_SCHEDULER_INTERVAL_MS=0)");
+    return false;
+  }
+
+  const runTick = () => {
+    if (state.stopping || state.tickInFlight) return; // never overlap ticks
+    state.tickInFlight = tick()
+      .catch((e: any) => console.error(`[anchor-scheduler] Tick-Fehler: ${e?.message || e}`))
+      .finally(() => {
+        state.letzterTick = new Date().toISOString();
+        state.tickInFlight = null;
+      });
+  };
+
+  state.timer = setInterval(runTick, state.intervalMs);
+  state.timer.unref?.();
+  console.log(
+    `[anchor-scheduler] gestartet — Intervall ${state.intervalMs} ms, ` +
+      `Submit via ${state.baseUrl}/api/chain/submit (bestehende Route, kein zweiter Code-Pfad)`
+  );
+
+  // Network guard once at startup (does not wait for the first tick).
+  pruefeNetzwerkKonsistenz().catch(() => {});
+  return true;
+}
+
+/**
+ * Graceful shutdown: stop the timer, then wait for an in-flight tick (i.e. a
+ * possibly running tx) to finish before resolving.
+ */
+export async function stopAnchorScheduler(): Promise<void> {
+  state.stopping = true;
+  if (state.timer) {
+    clearInterval(state.timer);
+    state.timer = null;
+  }
+  if (state.tickInFlight) {
+    console.log("[anchor-scheduler] Shutdown — warte auf laufenden Tick");
+    await state.tickInFlight.catch(() => {});
+  }
+  console.log("[anchor-scheduler] gestoppt");
+}
