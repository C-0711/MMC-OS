    .eckblock-titel { font-size: 11.5px; font-weight: 600; letter-spacing: .06em; color: rgba(0,0,0,.4); text-transform: uppercase; }
    .neu { position: absolute; font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #fff; background: #ff375f; border-radius: 999px; padding: 3px 9px; box-shadow: 0 4px 12px -3px rgba(255,55,95,.6); z-index: 4; }
    .zug { font-size: 11.5px; font-weight: 600; border-radius: 999px; padding: 2px 8px; display: inline-flex; align-items: center; gap: 4px; }
