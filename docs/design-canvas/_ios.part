    .reiter { flex: 1; height: 52px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; border-radius: 12px; font-size: 11px; color: rgba(0,0,0,.5); }
    .reiter.an { color: #0060df; background: rgba(255,255,255,.7); font-weight: 600; }
