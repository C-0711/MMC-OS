      box-shadow: 0 2px 8px rgba(20,40,70,.18);
      display: flex; align-items: center; justify-content: center;
    }
    .zug { font-size: 13px; font-weight: 500; border-radius: 999px; padding: 4px 10px; display: inline-flex; align-items: center; gap: 5px; }
    .zug-ok { color: #1c7d3e; background: rgba(52,199,89,.16); }
    .av { border-radius: 50%; flex: none; color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .leiste {
