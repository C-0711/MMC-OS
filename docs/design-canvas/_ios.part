    .prim {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      height: 52px; font-size: 17px; font-weight: 600; color: #fff; background: #0a84ff;
      border-radius: 999px; padding: 0 24px; box-shadow: 0 10px 26px -8px rgba(10, 132, 255, 0.7);
    }
