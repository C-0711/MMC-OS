  <style>
    /* OS-Sprache: #FAF7F2 / Salbei #8FA98F / Rosé #D9A6A0 / Olivgold #B8A369
       Schrift: Serife 34/22 (400, nie fett) · Sans 15/13/11 · Radius 16/8/999 */
    body { margin: 0; }
    a { color: #6e6550; }
    .os-grund {
      overflow: hidden; position: relative; display: flex; flex-direction: column;
      background: #FAF7F2; color: #2a2520;
      font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
      font-size: 15px; -webkit-font-smoothing: antialiased;
    }
    .serif { font-family: 'Playfair Display', Georgia, 'Times New Roman', serif; font-weight: 400; letter-spacing: -0.01em; }
    .t13 { font-size: 13px; }
    .t11 { font-size: 11px; }
    .sub { color: rgba(42,37,32,.55); }
    .karte {
      background: #fff; border: 1px solid rgba(184,163,105,.22); border-radius: 16px;
      box-shadow: 0 10px 34px -18px rgba(90,75,50,.35);
    }
    .pill-salbei {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      height: 44px; padding: 0 26px; border-radius: 999px;
      background: #8FA98F; color: #fff; font-size: 15px; font-weight: 600;
      box-shadow: 0 8px 22px -10px rgba(110,140,110,.7);
    }
    .pill-still {
      display: flex; align-items: center; justify-content: center;
      height: 44px; padding: 0 22px; border-radius: 999px;
      background: rgba(143,169,143,.14); color: #5c705c; font-size: 15px; font-weight: 500;
    }
    .siegel {
      width: 44px; height: 44px; border-radius: 999px; flex: none;
      background: radial-gradient(circle at 34% 30%, #c9b57e, #B8A369 58%, #96824c);
      color: #fff; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 12px -4px rgba(150,130,76,.6), inset 0 1px 2px rgba(255,255,255,.4);
      font-size: 14px;
    }
    .quellzeile {
      font-family: 'SF Mono', Menlo, Monaco, monospace; font-size: 11px; color: rgba(42,37,32,.6);
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    }
    .ampel { display: flex; gap: 8px; }
    .ampel span { width: 12px; height: 12px; border-radius: 999px; display: block; }
    .frag {
      display: flex; align-items: center; gap: 10px; height: 44px;
      background: #fff; border: 1px solid rgba(184,163,105,.3); border-radius: 999px;
      padding: 0 8px 0 18px; box-shadow: 0 4px 16px -8px rgba(90,75,50,.25);
    }
  </style>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&display=swap">
